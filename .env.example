# 复制成 .env(已 gitignore)。所有课只认 OpenAI 兼容的 /chat/completions 协议,换提供商只改这三个变量。
# 没设 LLM_API_KEY 时,EP0/EP1/EP3 退回用 GROQ_API_KEY;EP2 的 pi SDK 固定读 GROQ_API_KEY。

# ---- Groq 免费档(默认;console.groq.com/keys,不用绑卡)----
GROQ_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_MODEL=qwen/qwen3.8-27b        # EP0/EP1 复跑对照用过

# ---- Cerebras 免费档(cloud.cerebras.ai;5 次/分钟,100 万 tokens/天)----
# LLM_BASE_URL=https://api.cerebras.ai/v1
# LLM_API_KEY=csk-...
# LLM_MODEL=gpt-oss-120b

# ---- Cloudflare Workers AI(每天 1 万 neurons 免费;模型目录最全,llama-3.3-70b 还在)----
# EP0/EP1/EP3 实测可用;EP2 暂不行:pi 0.80.10 的 cloudflare-workers-ai provider 在回填工具结果时被 400
# 它的兼容端点不收 content: null,EP0/EP3 已补空串;裸循环用下面三个变量,EP2 用 CLOUDFLARE_API_KEY + CLOUDFLARE_ACCOUNT_ID
# LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# LLM_API_KEY=<带 Workers AI 权限的 API Token>
# LLM_MODEL=@cf/openai/gpt-oss-120b
# LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast   # 复现 EP0/EP1 的 2026-07 实验用这个

# ---- NVIDIA build.nvidia.com(注册送 1000 次,40 次/分钟,不绑卡)----
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-...
# LLM_MODEL=openai/gpt-oss-120b

# ---- 本地 Ollama(离线;16 GB 内存跑 8B 级模型)----
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b
